+static void vim_delete_lines(int32_t count)
+{
+ if(E.num_rows == 0)
+ {
+  return;
+ }
+ if(count < 1)
+ {
+  count=1;
+ }
+
+ int32_t start_y=E.c_y;
+ int32_t end_y=start_y+count-1;
+
+ if(end_y >= E.num_rows)
+ {
+  end_y=E.num_rows-1;
+ }
+
+ uint32_t total=0;
+ int32_t y=0;
+
+ for(y=start_y;y <= end_y;++y)
+ {
+  total+=E.row[y].size+1;
+ }
+
+ free(clipboard_buffer);
+ clipboard_buffer=malloc(total > 0 ? total : 1);
+
+ if(clipboard_buffer == NULL)
+ {
+  clipboard_len=0;
+ }
+ else
+ {
+  uint32_t pos=0;
+
+  for(y=start_y;y <= end_y;++y)
+  {
+   memcpy(clipboard_buffer+pos,E.row[y].characters,E.row[y].size);
+   pos+=E.row[y].size;
+   clipboard_buffer[pos]='\n';
+   ++pos;
+  }
+  clipboard_len=total;
+  clipboard_row_mode=1;
+  osc52_copy(clipboard_buffer,clipboard_len);
+ }
+
+ for(y=start_y;y <= end_y;++y)
+ {
+  actions action;
+  memset(&action,0,sizeof(action));
+  e_row* row=&E.row[start_y];
+
+  action.type=USER_ACTION_ROW_DELETE;
+  action.c_x=0;
+  action.c_y=start_y;
+  action.row_len=row->size;
+  action.row_text=row->size > 0 ? malloc(row->size) : NULL;
+
+  if(action.row_text != NULL)
+  {
+   memcpy(action.row_text,row->characters,row->size);
+   undo_push(&action);
+  }
+  else if(row->size == 0)
+  {
+   undo_push(&action);
+  }
+  else
+  {
+   set_status_message(ERROR_MSG_COLOR,"Low memory: row deleted, not added to undo history");
+  }
+
+  del_row(start_y);
+ }
+
+ E.c_x=0;
+
+ if(E.c_y >= E.num_rows && E.num_rows > 0)
+ {
+  E.c_y=E.num_rows-1;
+ }
+ E.dirty=1;
+}
