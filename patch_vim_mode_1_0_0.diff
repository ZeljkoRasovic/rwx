+static void vim_replace_char(uint16_t new_c,int32_t count)
+{
+ if(E.c_y >= E.num_rows || new_c < 32 || new_c >= ASCII_CHAR_LIMIT)
+ {
+  return;
+ }
+
+ int32_t i=0;
+
+ for(i=0;i < count;++i)
+ {
+  e_row* row=&E.row[E.c_y];
+
+  if(E.c_x >= row->size)
+  {
+   break;
+  }
+
+  actions del_action;
+  memset(&del_action,0,sizeof(del_action));
+
+  del_action.type=USER_ACTION_DEL_CHAR;
+  del_action.c_x=E.c_x+1;
+  del_action.c_y=E.c_y;
+  del_action.c_len=1;
+  del_action.c[0]=row->characters[E.c_x];
+  del_action.row_text=NULL;
+  undo_push(&del_action);
+  row_del_char(row,E.c_x);
+
+  actions ins_action;
+  memset(&ins_action,0,sizeof(ins_action));
+
+  ins_action.type=USER_ACTION_INSERT_CHAR;
+  ins_action.c_x=E.c_x;
+  ins_action.c_y=E.c_y;
+  ins_action.c[0]=(char)new_c;
+  ins_action.c_len=1;
+  ins_action.row_text=NULL;
+  undo_push(&ins_action);
+  row_insert_char(row,E.c_x,new_c);
+
+  ++E.c_x;
+ }
+
+ if(E.c_x > 0)
+ {
+  --E.c_x;
+ }
+ E.dirty=1;
+}
+
+static void vim_substitute_chars(int32_t count)
+{
+ if(E.c_y >= E.num_rows)
+ {
+  E.mode=MODE_INSERT;
+  return;
+ }
+
+ e_row* row=&E.row[E.c_y];
+ int32_t n=count;
+
+ if(E.c_x+n > row->size)
+ {
+  n=row->size-E.c_x;
+ }
+
+ int32_t i=0;
+
+ for(i=0;i < n;++i)
+ {
+  actions action;
+  memset(&action,0,sizeof(action));
+
+  action.type=USER_ACTION_DEL_CHAR;
+  action.c_x=E.c_x+1;
+  action.c_y=E.c_y;
+  action.c_len=1;
+  action.c[0]=row->characters[E.c_x];
+  action.row_text=NULL;
+  undo_push(&action);
+  row_del_char(row,E.c_x);
+ }
+
+ E.dirty=1;
+ E.mode=MODE_INSERT;
+}
