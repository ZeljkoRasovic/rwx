+static void vim_command_prompt()
+{
+ char* cmd=prompt(DEFAULT_MSG_COLOR,":%s",NULL);
+
+ if(cmd == NULL)
+ {
+  return;
+ }
+
+ if(strcmp(cmd,"w") == 0)
+ {
+  save_file();
+ }
+ else if(strcmp(cmd,"wq") == 0)
+ {
+  save_file();
+  write_all(STDOUT_FILENO,"\x1b[2J",4);
+  write_all(STDOUT_FILENO,"\x1b[H",3);
+  exit(0);
+ }
+ else if(strcmp(cmd,"q!") == 0)
+ {
+  write_all(STDOUT_FILENO,"\x1b[2J",4);
+  write_all(STDOUT_FILENO,"\x1b[H",3);
+  exit(0);
+ }
+ else if(strcmp(cmd,"q") == 0)
+ {
+  if(E.dirty)
+  {
+   set_status_message(ERROR_MSG_COLOR,"WARNING, file has unsaved changes, use :wq to save or :q! to force quit.");
+  }
+  else
+  {
+   write_all(STDOUT_FILENO,"\x1b[2J",4);
+   write_all(STDOUT_FILENO,"\x1b[H",3);
+   exit(0);
+  }
+ }
+ else
+ {
+  set_status_message(ERROR_MSG_COLOR,"Unknown command: %s",cmd);
+ }
+
+ free(cmd);
+}
