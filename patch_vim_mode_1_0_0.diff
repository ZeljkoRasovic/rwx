+static void vim_paste_after()
+{
+ if(clipboard_buffer == NULL || clipboard_len == 0)
+ {
+  return;
+ }
+
+ if(clipboard_row_mode)
+ {
+  paste_clipboard();
+  return;
+ }
+
+ if(E.c_y < E.num_rows && E.c_x < E.row[E.c_y].size)
+ {
+  E.c_x+=get_utf8_char_placement_length(&E.row[E.c_y],E.c_x);
+ }
+ paste_clipboard();
+}
+
+static void vim_paste_before()
+{
+ if(clipboard_buffer == NULL || clipboard_len == 0)
+ {
+  return;
+ }
+
+ if(clipboard_row_mode)
+ {
+  E.c_y-=1;
+  paste_clipboard();
+  return;
+ }
+ paste_clipboard();
+}
