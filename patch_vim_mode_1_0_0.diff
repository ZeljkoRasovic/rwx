+static void vim_change_word(int32_t count,char kind)
+{
+ int32_t i=0;
+ int32_t start_x=E.c_x;
+ int32_t start_y=E.c_y;
+
+ if(kind == 'e')
+ {
+  E.select_mode=SELECT_CHAR;
+  E.select_anchor_x=start_x;
+  E.select_anchor_y=start_y;
+
+  for(i=0;i < count;++i)
+  {
+   motion_word_end();
+  }
+
+  copy_selection();
+  delete_selection();
+  E.select_mode=SELECT_NONE;
+ }
+ else
+ {
+  for(i=0;i < count;++i)
+  {
+   motion_word_backward();
+  }
+
+  delete_range_with_undo(E.c_x,E.c_y,start_x,start_y);
+ }
+
+ E.mode=MODE_INSERT;
+}
